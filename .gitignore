# /docs/

# Ignore environment files
.env
.env.*.local
*.local

# .NET build artifacts
bin/
obj/
**/bin/
**/obj/

# Visual Studio caches and user files
*.user
*.suo
*.vcxproj.user
*.userosscache
*.sln.docstates

# Node / Next.js
node_modules/
.next/
out/
**/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS files
.DS_Store
Thumbs.db

# Ignore uploaded files (prevent committing user uploads)
# Ignore specific API host uploads folder
/backend/src/AMS.HttpApi.Host/wwwroot/uploads/

# Ignore any uploads folder under wwwroot in projects
**/wwwroot/uploads/

# Ignore App_Data uploads folder contents (keep folder if you want by adding a .gitkeep)
# Ignore all files under any App_Data/Uploads directory
App_Data/Uploads/
**/App_Data/Uploads/
# If you prefer to keep the empty folder tracked, use a .gitkeep and un-ignore it:
# App_Data/Uploads/*
# !App_Data/Uploads/.gitkeep
# **/App_Data/Uploads/*
# !**/App_Data/Uploads/.gitkeep
